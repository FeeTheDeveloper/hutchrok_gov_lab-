# Local-only SAM.gov API configuration
# Copy to .env and fill your own key (do not commit .env)
SAM_GOV_API_KEY=replace-with-your-key

# Optional overrides for API mode
# SAM_GOV_API_ENDPOINT=https://api.sam.gov/prod/opportunities/v2/search

# Optional API server port
# PORT=3000

# Optional browser origin allowed by the local API server
# GOVREADY_ALLOWED_ORIGIN=http://127.0.0.1:8000
