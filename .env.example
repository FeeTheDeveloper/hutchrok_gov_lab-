# Local-only SAM.gov API configuration
# Copy to .env and fill your own key (do not commit .env)
SAM_GOV_API_KEY=replace-with-your-key

# Optional overrides for API mode
# SAM_GOV_API_ENDPOINT=https://api.sam.gov/prod/opportunities/v2/search
# SAM_API_TIMEOUT_MS=30000
# SAM_API_RETRIES=2
# SAM_API_RETRY_BASE_MS=800

# Optional API server port
# PORT=3000
# GOVREADY_API_HOST=127.0.0.1

# Optional local persistence and generated-output roots
# GOVREADY_DATA_DIR=.govready
# GOVREADY_OUT_DIR=out

# Optional browser origin allowed by the local API server or Vercel function
# GOVREADY_ALLOWED_ORIGIN=http://127.0.0.1:8000

# On Vercel, add SAM_GOV_API_KEY and GOVREADY_ALLOWED_ORIGIN in Project Settings.
# Do not add PORT, GOVREADY_DATA_DIR, or GOVREADY_OUT_DIR there.
